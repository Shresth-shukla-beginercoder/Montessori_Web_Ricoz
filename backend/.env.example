# Backend environment — copy to .env and fill in real values
NODE_ENV=development
PORT=4000

# Dev (host machine — reaches the existing mongodb-server container through its published 127.0.0.1 port):
MONGODB_URI=mongodb://<user>:<password>@127.0.0.1:27017/<database>?authSource=admin
# Docker (application network — container-to-container, never host-published):
# MONGODB_URI=mongodb://<user>:<password>@mongodb-server:27017/<database>?authSource=admin

LOG_LEVEL=info
# JWT_SECRET=<secret>   (required when Part 15 authentication is added)
